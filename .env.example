# ==============================================================================
# ANURGO STUDIO — CLIENT LEAD NOTIFICATION CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and populate with your actual service credentials.
# NEVER commit your actual '.env' file or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EMAIL NOTIFICATION (Resend API - https://resend.com)
# ------------------------------------------------------------------------------
# Obtain your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# The destination email address where new client leads will be delivered
NOTIFICATION_EMAIL=your-email@example.com

# The verified sender email address. For testing, Resend provides 'onboarding@resend.dev'.
# Once you verify your custom domain in Resend, use e.g. 'ANURGO Studio <leads@anurgo.com>'.
FROM_EMAIL=ANURGO Studio <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 2. WHATSAPP NOTIFICATION (Twilio WhatsApp API - https://www.twilio.com)
# ------------------------------------------------------------------------------
# Obtain your Account SID and Auth Token from your Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio WhatsApp sender number.
# For Twilio Sandbox testing, use 'whatsapp:+14155238886'.
# For production, use your approved Twilio WhatsApp Sender number.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Destination WhatsApp phone number (with country code, prefixed by 'whatsapp:')
WHATSAPP_TO=whatsapp:+1234567890
