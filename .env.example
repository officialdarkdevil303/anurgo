# ==============================================================================
# ANURGO STUDIO — FULLSTACK CONFIGURATION & SERVICE CREDENTIALS
# ==============================================================================
# Copy this file to '.env' and populate with your actual service credentials.
# NEVER commit your actual '.env' file or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & AUTHENTICATION
# ------------------------------------------------------------------------------
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_PATH=database/anurgo.db

# Cryptographically strong secret key used for signing JWT client session tokens
JWT_SECRET=anurgo_studio_super_secret_jwt_key_2026_change_in_production

# ------------------------------------------------------------------------------
# 2. EMAIL NOTIFICATION & OTP DISPATCH (Resend API - https://resend.com)
# ------------------------------------------------------------------------------
# Obtain your free API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Destination email address where ANURGO owner receives new client briefs
NOTIFICATION_EMAIL=workwithanuragchauhan@gmail.com

# The verified sender email address. For testing, Resend provides 'onboarding@resend.dev'.
# Once you verify your custom domain in Resend, use e.g. 'ANURGO Studio <leads@anurgo.com>'.
FROM_EMAIL=ANURGO Studio <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 3. WHATSAPP NOTIFICATION (Twilio WhatsApp API / WhatsApp Business API)
# ------------------------------------------------------------------------------
# Obtain your Account SID and Auth Token from: https://console.twilio.com
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio WhatsApp sender number.
# For Twilio Sandbox testing, use 'whatsapp:+14155238886'.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Destination WhatsApp phone number for the studio owner (format: whatsapp:+[country_code][number])
WHATSAPP_TO=whatsapp:+917991192205
